{
  "name": "healthconnect",
  "version": "1.0.0",
  "description": "HealthConnect - Health Education Platform",
  "private": true,
  "scripts": {
    "install:all": "cd Backend && npm install --quiet --audit=false && cd ../Frontend && npm install --quiet --audit=false",
    "build": "npm run install:all && cd Frontend && npm run build",
    "start": "cd Frontend && npm start",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd Backend && npm run dev",
    "dev:frontend": "cd Frontend && npm run dev"
  },
  "keywords": ["health", "education", "healthcare", "nextjs", "express"],
  "author": "HealthConnect Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}